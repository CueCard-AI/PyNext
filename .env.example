# PyNext Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env

# =============================================================================
# AI Code Generation (Optional)
# =============================================================================

# Anthropic API Key - Required for `pynext g <type> <name> --ai`
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# =============================================================================
# Database (Optional - for PostgreSQL features)
# =============================================================================

# PostgreSQL connection URL
# DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# Supabase (if using Supabase integration)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_KEY=your-service-key

# =============================================================================
# Development
# =============================================================================

# Set to "development" or "production"
# PYNEXT_ENV=development

# Enable debug logging
# PYNEXT_DEBUG=true
